{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A cosmetic or jewelry product available for purchase.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "price": { "type": "number" },
        "category": { "type": "string", "enum": ["Skincare", "Makeup", "Fragrance", "Body Care", "Jewelry"] },
        "image": { "type": "string", "maxLength": 500 },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" }
      },
      "required": ["id", "name", "price", "category", "image"]
    },
    "Review": {
      "title": "Review",
      "description": "A customer review for a specific product.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "productId", "userId", "userName", "rating", "comment", "createdAt"]
    },
    "PaymentReceiptInfo": {
      "title": "PaymentReceiptInfo",
      "description": "Tokenized, PCI DSS compliant payment receipt metadata.",
      "type": "object",
      "properties": {
        "gateway": { "type": "string", "maxLength": 60 },
        "method": { "type": "string", "enum": ["card", "netbanking", "wallet", "upi"] },
        "transactionId": { "type": "string", "maxLength": 100 },
        "maskedInstrument": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["captured", "authorized"] },
        "currency": { "type": "string", "enum": ["INR"] },
        "signatureHash": { "type": "string", "maxLength": 128 },
        "authorizedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["gateway", "method", "transactionId", "maskedInstrument", "status", "currency", "signatureHash", "authorizedAt"]
    },
    "CustomerInfo": {
      "title": "CustomerInfo",
      "description": "Shipping recipient contact details.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 30 }
      },
      "required": ["name", "email", "address", "phone"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order containing multiple products and tokenized payment receipt.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerInfo": { "$ref": "CustomerInfo", "type": "object" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["placed", "processing", "shipped", "delivered"] },
        "paymentInfo": { "$ref": "PaymentReceiptInfo", "type": "object" },
        "createdAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["id", "userId", "customerInfo", "items", "total", "status", "paymentInfo", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "App user profile with wishlist.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "avatar": { "type": "string", "maxLength": 500 },
        "wishlist": { "type": "array" }
      },
      "required": ["id", "name", "email"]
    }
  },
  "firestore": {
    "products": { "schema": "Product", "description": "Collection of cosmetic products." },
    "reviews": { "schema": "Review", "description": "Collection of product reviews." },
    "orders": { "schema": "Order", "description": "Collection of customer orders." },
    "users": { "schema": "User", "description": "Collection of user profiles." }
  }
}
